# Copy to terraform.tfvars (gitignored) and fill in real values.

region         = "ap-southeast-1"
instance_type  = "t3.micro"
ami            = "ami-xxxxxxxxxxxxxxxxx" # resolve a current AMI for your region/OS
count_instance = 1

key_pair_id = "~/.ssh/id_rsa.pub"
private_key = "~/.ssh/id_rsa"
user        = "ubuntu"

command = [
  "sudo apt-get update -y",
  "echo bootstrap ok",
]

# --- Optional (defaults shown) ----------------------------------------------
# app_port                = 80
# ssh_allowed_cidr_blocks = ["0.0.0.0/0"]   # narrow this in real use
# vpc_cidr                = "10.0.0.0/16"
# root_volume_size        = 30
# root_volume_type        = "gp3"

# --- Backend values (consumed via -backend-config, not by main.tf directly) -
backend_bucket         = "maza-remote-state-storage-s3"
backend_key            = "infrastructure/tfremote/terraform.tfstate"
backend_dynamodb_table = "terraform-state-lock-dynamo"
